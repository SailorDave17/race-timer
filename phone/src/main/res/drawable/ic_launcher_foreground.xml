<?xml version="1.0" encoding="utf-8"?>
<!-- COPY of wear/src/main/res/drawable/ic_launcher_foreground.xml. Two application modules
     cannot share a resource directory, so the launcher mark exists once per module and the copies
     are bound by this comment and nothing else. If one changes, change both. -->
<!-- Adaptive-icon foreground layer: a sloop's sail plan inside a stopwatch bezel.

     The mark is the sails, not the dial — a countdown that exists for sailing should read as
     sailing first. The scarlet bezel and the crown carry the timer half; they sit at the rim where
     they frame rather than compete, so at launcher size the eye gets white sails on charcoal and
     nothing else has to survive.

     Scarlet and grey, owner decision 2026-08-12, replacing gold on navy. The scarlet is a near
     neighbour of `BG_FINAL_TEN_ARGB` (shared/.../MessageContrast.kt), the final-ten-seconds alarm,
     which #198 made the one definition of it. Harmless for an icon, which
     is never on screen during a race — but it constrains any future theme change, because a
     countdown UI in this palette would cost that alarm its punch.

     Everything stays inside the 66dp safe zone of the 108dp canvas: the bezel is r=30 with a
     4.5 stroke (32.25 at its outer edge) and the crown reaches y=22, which is 32 from centre.

     store/render_store_icon.py restates this geometry for the 512x512 Play listing icon and
     drawable/ic_stat_race_timer.xml restates it again at 24dp for the notification, where only
     the alpha channel survives — change one and both must follow. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stopwatch bezel -->
    <path
        android:strokeColor="#BB0000"
        android:strokeWidth="4.5"
        android:pathData="M54,54m-30,0a30,30 0,1 1,60 0a30,30 0,1 1,-60 0" />

    <!-- Crown, bridging the bezel at 12 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,22L58,22L58,28L50,28Z" />

    <!-- Mainsail: near-vertical luff, curved leech falling away to starboard -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M57,32L55,70L72,70Q71,46 57,32Z" />

    <!-- Jib: shorter, set forward of the mast, luff bowing to port -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,44L51,70L37,70Q41,55 50,44Z" />

    <!-- Waterline -->
    <path
        android:strokeColor="#BB0000"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M39,74.5L69,74.5" />
</vector>
