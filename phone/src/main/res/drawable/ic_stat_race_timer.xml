<?xml version="1.0" encoding="utf-8"?>
<!-- Copied byte-for-byte from wear/src/main/res/drawable/ic_stat_race_timer.xml (#203): two
     application modules cannot share a resource directory, so this is a sibling copy of one
     geometry, bound to the original by this comment alone — the same arrangement as the launcher
     mark (#197). Edit the wear copy and re-copy; do not let the two drift.

     Notification / ongoing-activity icon: the same sail-plan-in-a-bezel mark at 24dp.

     Deliberately NOT the launcher foreground layer. Android renders a small icon from its alpha
     channel alone and tints the result, so only the silhouette survives — the launcher layer's
     gold/white distinction would vanish and its waterline would read as a stray bar.

     So this drops the crown and the waterline and keeps the two shapes that still say "sailing
     countdown" as a flat silhouette: the bezel as an open stroke, and the sails filled. The gap
     between jib and mainsail is widened relative to the launcher mark, because at 24dp a 4dp gap
     closes up. Verify by rendering the alpha channel, never in a preview that composites for you. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- Bezel -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:pathData="M12,12m-10,0a10,10 0,1 1,20 0a10,10 0,1 1,-20 0" />

    <!-- Mainsail -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12.9,4.6L12.4,17.4L18,17.4Q17.6,9.4 12.9,4.6Z" />

    <!-- Jib -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10.4,8.4L10.9,17.4L6,17.4Q7.6,12.4 10.4,8.4Z" />
</vector>
