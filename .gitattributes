# The Gradle wrapper must survive a round trip through any contributor's autocrlf setting.
# `gradlew` is a POSIX shell script: a CRLF checkout gives it a `#!/bin/sh\r` shebang, which
# Linux and macOS (and therefore CI) refuse to execute. The .bat is the mirror image, and the
# wrapper jar must never be treated as text.
gradlew        text eol=lf
gradlew.bat    text eol=crlf
*.jar          binary

# Normalize sources in the repo, checked out per-platform.
*.kt    text
*.kts   text
*.toml  text
*.md    text
*.pro   text
*.xml   text

# githooks/ holds a POSIX shell script plus plain-text list files that
# githooks/pre-push reads line by line. This machine has core.autocrlf=true, so
# without this rule they check out CRLF and `rebuild/v1\r` stops equalling
# `rebuild/v1` - the branch then falls through the owner-only list and is pushed
# as if it were a feature branch. Measured on Taskr 2026-08-05: the file was
# present, correct in the repo, `git status` clean, and the guard silently off.
#
# The hook strips a trailing CR itself as well. Neither half replaces the other:
# .gitattributes governs checkout and so fixes the files in repos that carry it,
# while the in-hook strip covers any clone or repo that does not.
/githooks/*    text eol=lf

# docs/declared-surface.lock is compared BYTE-FOR-BYTE against freshly generated output by
# .github/scripts/declared-surface.py --check, so it must not change shape on the way through a
# checkout. This machine has core.autocrlf=true: without this rule the committed copy checks out
# CRLF, the generator writes LF, and the check fails on every run for a reason that has nothing to
# do with the app's declared surface - which is how a guard gets disabled (#83 AC 3).
*.lock         text eol=lf
