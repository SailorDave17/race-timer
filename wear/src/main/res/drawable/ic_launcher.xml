<?xml version="1.0" encoding="utf-8"?>
<!-- Simple vector launcher icon for the race timer (a stopwatch / flag shape) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Background circle -->
    <path
        android:fillColor="#1A1A2E"
        android:pathData="M54,54m-54,0a54,54 0,1 1,108 0a54,54 0,1 1,-108 0" />
    <!-- Clock face circle -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,54m-34,0a34,34 0,1 1,68 0a34,34 0,1 1,-68 0" />
    <!-- Clock body -->
    <path
        android:fillColor="#1A1A2E"
        android:pathData="M54,54m-28,0a28,28 0,1 1,56 0a28,28 0,1 1,-56 0" />
    <!-- Minute hand pointing to 12 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:pathData="M54,54L54,32" />
    <!-- Hour hand pointing to 10 -->
    <path
        android:strokeColor="#FFD700"
        android:strokeWidth="3"
        android:pathData="M54,54L40,42" />
    <!-- Crown / button at top -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,20L58,20L58,26L50,26Z" />
</vector>
